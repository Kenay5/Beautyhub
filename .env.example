# Keep real values outside version control. Do not commit a .env file.
# PostgreSQL connection used by BeautyHub at runtime.
BEAUTYHUB_DATABASE_URL=postgresql+psycopg://<username>:<password>@<hostname>:5432/beautyhub_dev
# PostgreSQL connection used by the integration-test harness.
BEAUTYHUB_TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@<hostname>:5432/beautyhub_test
# Base64url-encoded 32-byte key. Generate it outside the repository and never commit it.
BEAUTYHUB_PRIVATE_CODE_MASTER_KEY=<base64url-encoded-32-byte-secret>
# Non-secret identifier for the external cryptography root-key version.
BEAUTYHUB_CRYPTOGRAPHY_KEY_VERSION=v1
# Optional comma-separated proxy IP/CIDR allowlist. Forwarded client IPs are ignored otherwise.
BEAUTYHUB_TRUSTED_PROXY_CIDRS=
